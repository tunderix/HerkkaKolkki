{
    "compilerOptions": {
        "target": "es2021",
        "module": "ESNext",
        "lib": ["es2021"],
        "declaration": true,
        "sourceMap": true,
        "outDir": "./dist",
        "rootDir": "./src",
        "strict": false,
        "moduleResolution": "node",
        "esModuleInterop": true,
        "experimentalDecorators": true,
        "emitDecoratorMetadata": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true,
        "baseUrl": "./src",
        "paths": {
            "@buttons/*": ["buttons/*"],
            "@commands/*": ["commands/*"],
            "@constants/*": ["constants/*"],
            "@controllers/*": ["controllers/*"],
            "@embedCreators/*": ["embedCreators/*"],
            "@enums/*": ["enums/*"],
            "@events/*": ["events/*"],
            "@extensions/*": ["extensions/*"],
            "@heroes/*": ["heroes/*"],
            "@jobs/*": ["jobs/*"],
            "@middleware/*": ["middleware/*"],
            "@models/*": ["models/*"],
            "@reactions/*": ["reactions/*"],
            "@services/*": ["services/*"],
            "@triggers/*": ["triggers/*"],
            "@utils/*": ["utils/*"]
        }
    },
    "exclude": ["dist", "node_modules", "tests"]
}
